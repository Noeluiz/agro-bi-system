# =====================================================================
# 🔒 AGRO-BI SYSTEM - GIT IGNORE RULES (SECURITY-FOCUSED)
# =====================================================================
# Este arquivo previne que arquivos sensíveis sejam versionados no Git
# Última atualização: 2026-08-07
# =====================================================================

# =====================================================================
# 🔐 ENVIRONMENT & SECRETS - CRÍTICO
# =====================================================================
# Variáveis de ambiente (NUNCA versionem)
.env
.env.local
.env.*.local
.env.*.prod
.env.development.local
.env.test.local
.env.production.local

# Excepção: Permitir apenas arquivo de exemplo
!.env.example
!.env.example.local

# =====================================================================
# 🔒 CREDENCIAIS & CHAVES PRIVADAS
# =====================================================================
# Certificados TLS/SSL
*.pem
*.key
*.p12
*.pfx
*.cert
*.crt
*.cer
*.jks
*.keystore
*.pks12

# Diretórios de credenciais
secrets/
credentials/
.aws/
.gcp/
.azure/
.ssh/

# Arquivos de configuração sensível
config/secrets.yml
config/secrets.json
secrets.yml
secrets.json

