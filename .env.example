# =====================================================================
# 🔒 Agro-BI System - Environment Variables Template
# =====================================================================
# IMPORTANTE: Este é um arquivo de EXEMPLO. 
# NUNCA commit .env com valores reais - use este arquivo como template
# Copie para .env local e preencha com seus valores
#
# Geração de chaves seguras:
#   SECRET_KEY: openssl rand -hex 32
#   POSTGRES_PASSWORD: openssl rand -hex 16
# =====================================================================

# =====================================================================
# PostgreSQL Database Configuration
# =====================================================================
# Usuário do banco de dados
POSTGRES_USER=postgres

# MUDE ISTO EM PRODUÇÃO!
# Gere com: openssl rand -hex 16
# Mínimo 12 caracteres, sem caracteres especiais perigosos
POSTGRES_PASSWORD=CHANGE_ME_IN_PRODUCTION_use_openssl_rand_hex_16

# Nome do banco de dados
POSTGRES_DB=agro_estoque

# =====================================================================
# Database Connection URL
# =====================================================================
# Formato: postgresql+pg8000://usuario:senha@host:porta/database
# Em desenvolvimento: host = 'db' (nome do serviço Docker)
# Em produção: host = seu IP/hostname real
# 
# IMPORTANTE: Substitua valores reais (especialmente a senha)
DATABASE_URL=postgresql+pg8000://postgres:CHANGE_ME_IN_PRODUCTION_use_openssl_rand_hex_16@db:5432/agro_estoque

# =====================================================================
# Backend Security - JWT
# =====================================================================
# Define o ambiente de execução. Em production, o seed de usuários padrão é desabilitado.
ENVIRONMENT=development

# Chave secreta para assinar tokens JWT
# Gere com: openssl rand -hex 32
# Mínimo 32 caracteres (64 caracteres hexadecimais = 32 bytes)
# NUNCA use a mesma chave em múltiplos ambientes
SECRET_KEY=YOUR_SECRET_KEY_HERE_GENERATE_WITH_openssl_rand_hex_32_MINIMUM

# Algoritmo de assinatura JWT
JWT_ALGORITHM=HS256

# Tempo de expiração do token em minutos (padrão: 60 = 1 hora)
ACCESS_TOKEN_EXPIRE_MINUTES=60

# =====================================================================
# Cookie Configuration
# =====================================================================
# Nome do cookie de autenticação (padrão: agro_bi_token)
AUTH_COOKIE_NAME=agro_bi_token

# Em PRODUÇÃO com HTTPS: true
# Em DESENVOLVIMENTO: false (para testar localmente sem HTTPS)
COOKIE_SECURE=false

# Proteção contra CSRF - recomendado manter 'strict'
# Valores válidos: strict, lax, none
COOKIE_SAMESITE=none

# =====================================================================
# CORS (Cross-Origin Resource Sharing)
# =====================================================================
# Origens permitidas para requisições CORS (separadas por vírgula)
# Lista TODAS as origens do seu frontend que farão requisições
#
# Desenvolvimento: http://localhost:5173,http://127.0.0.1:5173
# Produção: https://seu-dominio.com
#
# NUNCA use '*' em produção com credentials=true
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Identidade institucional usada nos PDFs das Ordens de Aplicação
FAZENDA_RAZAO_SOCIAL=Razão Social da Fazenda
FAZENDA_CNPJ=00.000.000/0000-00
FAZENDA_ENDERECO=Endereço da Fazenda,  s/n
FAZENDA_CIDADE_UF=Cidade - UF
# Caminho local ou volume persistente do logo PNG/JPG; deixe vazio para usar o placeholder Agro-BI
AGRO_BI_LOGO_PATH=

# =====================================================================
# HTTPS & Security Headers (Produção)
# =====================================================================
# Ativar HTTP Strict Transport Security (HSTS)
# APENAS em produção com certificado HTTPS válido
# Valores: true (produção), false (desenvolvimento)
ENABLE_HSTS=false

# =====================================================================
# Servidor & Portas
# =====================================================================
# Host do backend (Docker: 'backend', local: '127.0.0.1')
BACKEND_HOST=backend

# Porta do backend (padrão: 8000)
BACKEND_PORT=8000

# Porta do frontend (padrão: 5173 para Vite)
FRONTEND_PORT=5173

# =====================================================================
# Logging
# =====================================================================
# Nível de log (DEBUG, INFO, WARNING, ERROR, CRITICAL)
# Desenvolvimento: INFO ou DEBUG
# Produção: WARNING ou ERROR
LOG_LEVEL=INFO

# =====================================================================
# EXEMPLO DE PRODUÇÃO
# =====================================================================
# Descomente e adapte para produção:
#
# POSTGRES_PASSWORD=use_generated_strong_password
# DATABASE_URL=postgresql+pg8000://postgres:use_generated_strong_password@prod-db.example.com:5432/agro_estoque
# SECRET_KEY=use_openssl_rand_hex_32_output_here
# COOKIE_SECURE=true
# ENABLE_HSTS=true
# CORS_ORIGINS=https://agro-bi-system.vercel.app
# LOG_LEVEL=WARNING
#
# =====================================================================
