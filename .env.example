# =====================================================================
# Agro-BI System - Environment Variables Template (Production-ready)
# =====================================================================
# IMPORTANTE: este arquivo é um template. Nunca commite um arquivo .env real.
# Para produção, copie este conteúdo para um .env válido com seus valores reais.
# =====================================================================

# ===============================
# Banco de dados
# ===============================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_IN_PRODUCTION
POSTGRES_DB=agro_estoque
DATABASE_URL=postgresql+pg8000://postgres:CHANGE_ME_IN_PRODUCTION@your-railway-host:5432/agro_estoque

# ===============================
# Ambiente e segurança
# ===============================
ENVIRONMENT=production
SECRET_KEY=CHANGE_ME_TO_A_STRONG_SECRET_AT_LEAST_32_BYTES
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Cookie de autenticação
AUTH_COOKIE_NAME=agro_bi_token
CSRF_COOKIE_NAME=agro_bi_csrf
CSRF_HEADER_NAME=X-CSRF-Token
COOKIE_SECURE=true
COOKIE_SAMESITE=none

# CORS (produzido para Vercel)
CORS_ORIGINS=https://agro-bi-system.vercel.app

# HSTS / headers de segurança
ENABLE_HSTS=true

# ===============================
# Limites e proteção
# ===============================
PDF_LIMIT_PER_MINUTE=5
MAX_ITENS_COMPRA=50
MAX_ALERTAS_POR_DIA=20

# ===============================
# Logs e auditoria
# ===============================
LOG_LEVEL=WARNING

# ===============================
# Railway / deploy
# ===============================
# Estes valores são opcionais em muitos deploys, mas a aplicação os reconhece:
RAILWAY_ENVIRONMENT_NAME=production
RAILWAY_SERVICE_NAME=agro-bi-api

# ===============================
# Dados institucionais (PDF / relatórios)
# ===============================
FAZENDA_RAZAO_SOCIAL=Agro-BI Fazenda
FAZENDA_CNPJ=00.000.000/0000-00
FAZENDA_ENDERECO=Endereço da Fazenda, s/n
FAZENDA_CIDADE_UF=Cidade - UF
AGRO_BI_LOGO_PATH=
AGRO_BI_FONT_REGULAR=
AGRO_BI_FONT_BOLD=

# ===============================
# Infra / runtime
# ===============================
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=5173

# ===============================
# Exemplo de produção válido
# ===============================
# ENVIRONMENT=production
# COOKIE_SECURE=true
# COOKIE_SAMESITE=none
# CORS_ORIGINS=https://agro-bi-system.vercel.app
# DATABASE_URL=postgresql+pg8000://postgres:strong_password@host:5432/agro_estoque
# SECRET_KEY=openssl rand -hex 32
# ENABLE_HSTS=true
# LOG_LEVEL=WARNING
# =====================================================================
